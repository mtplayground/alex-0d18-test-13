{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "npm run db:generate && tsc -b"
  },
  "dependencies": {
    "@myclawteam/shared": "file:../shared",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.32",
    "prisma": "^6.19.3",
    "tsx": "^4.20.3"
  }
}
